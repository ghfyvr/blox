:brain:(*) {
    global __, c, d, a, e
    if (!__)
        return

    :ice_cube: := Gdip_BitmapFromScreen(0, 0, A_ScreenWidth, A_ScreenHeight)
    Gdip_SaveBitmapToFile(:ice_cube:, c)
    RunWait Format('tesseract "{1}" "{2}" --psm 6 -c tessedit_create_tsv=1', c, A_ScriptDir "\ocr"),, "Hide"
    if !FileExist(d)
        return

    :jigsaw: := 0
