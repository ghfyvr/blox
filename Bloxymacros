    Loop Read, d {
        if (A_Index = 1)
            continue
        :axe: := StrSplit(A_LoopReadLine, "`t")
        if 🪓.Length < 12
            continue
        📦 := 🪓[12]
        if RegExMatch(📦, "i)^(\d+(?:\.\d+)?)\s*[mM]$", &💰) {
            💸 := 💰[1] + 0
            if (💸 >= 5 && 💸 > 🧩) {
                🧩 := 💸
                🔑 := {x:🪓[7], y:🪓[8], w:🪓[9], h:🪓[10]}
            }
        }
    }

    if (🧩 = 0)
        return

    📍x := 🔑.x + 🔑.w // 2
    📍y := 🔑.y + 🔑.h // 2
