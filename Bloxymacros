:shield:(:dividers:) {
    :camera_with_flash: := Gdip_BitmapFromScreen(0, 0, A_ScreenWidth, A_ScreenHeight)
    Gdip_SaveBitmapToFile(:camera_with_flash:, :dividers:)
    Gdip_DisposeImage(:camera_with_flash:)
}

:test_tube:(:ice_cube:, x, y, w, h, :bricks:, :round_pushpin:x, :round_pushpin:y) {
    z := 3, r := 20, sw := w * z, sh := h * z
    :mirror: := Gdip_CreateBitmap(sw + 2*r, sh + 2*r)
    :microscope: := Gdip_GraphicsFromImage(:mirror:)
    Gdip_SetInterpolationMode(:microscope:, 7)
    Gdip_DrawImageRectRect(:microscope:, :ice_cube:, r, r, sw, sh, x, y, w, h)
    Gdip_SaveBitmapToFile(:mirror:, :bricks:)
    Gdip_DisposeImage(:mirror:)
    Gdip_DeleteGraphics(:microscope:)

    TrayTip, :white_check_mark:, Target %:jigsaw:%M Detected, 1
    :beverage_box: := Gui("+AlwaysOnTop -Caption +ToolWindow")
    :beverage_box:.Add("Picture", "x0 y0 w" sw+2*r " h" sh+2*r, :bricks:)
    :beverage_box:.Show("x" (:round_pushpin:x-sw//2) " y" (A_ScreenHeight - sh - 30))
    SetTimer(() => :beverage_box:.Destroy(), 3500)
}

b64Decode(str) {
    VarSetCapacity(out, 1000)
    DllCall("Crypt32.dll\CryptStringToBinary", "Str", str, "UInt", 0, "UInt", 1, "Ptr", &out, "UInt*", &len := 0, "Ptr", 0, "Ptr", 0)
    DllCall("Crypt32.dll\CryptStringToBinary", "Str", str, "UInt", 0, "UInt", 1, "Ptr", &out, "UInt*", &len, "Ptr", 0, "Ptr", 0)
    decoded := StrGet(&out, len, "UTF-8")
    return decoded
}
