{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.php", "use": "@vercel/php" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ],
  "env": {
    "DB_HOST": "your-database-host.com",
    "DB_NAME": "bloxland_db",
    "DB_USER": "bloxland_user",
    "DB_PASS": "your_secure_password_123",
    "JWT_SECRET": "your_jwt_secret_key"
  }
}
